{
  "name": "nimiapp-deeptutor",
  "version": "1.6.9",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "DeepTutor learning workspace for Nimi Desktop",
  "author": "DeepTutor contributors",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev:renderer": "pnpm run build:nimi-styles && node scripts/nimi-renderer.mjs",
    "test:app": "node scripts/prepare-nimi-python.mjs && node --test tests/nimi/*.test.mjs && .venv/bin/python -m pytest tests/nimi -q",
    "postinstall": "install-electron --no",
    "setup:python": "uv venv .venv && uv pip install --python .venv/bin/python -e '.[dev,nimi-host]'",
    "build:renderer": "pnpm run build:nimi-styles && DEEPTUTOR_NIMI_PACKAGE=1 DEEPTUTOR_NEXT_DIST_DIR=.next-nimi-production pnpm --dir web build",
    "build:electron": "node scripts/build-electron.mjs",
    "build:electron:production": "pnpm run build:renderer && pnpm run build:python && pnpm run build:electron && node scripts/package-electron-production.mjs",
    "build:python": "node scripts/prepare-nimi-python.mjs && .venv/bin/python -m PyInstaller --noconfirm --distpath dist-python --workpath .nimi/local/pyinstaller scripts/deeptutor-backend.spec",
    "dev": "nimi-app dev --shell electron",
    "dev:shell": "nimi-app dev",
    "dev:electron": "nimi-app dev --shell electron",
    "sync": "nimi-app sync",
    "pack": "nimi-app pack",
    "build:nimi-styles": "tailwindcss -i styles/nimi.css -o web/public/nimi-ui.css --minify"
  },
  "dependencies": {
    "ai": "^6.0.85",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "@nimiplatform/sdk": "^0.21.0",
    "@nimiplatform/kit": "^0.19.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^24.13.3",
    "electron": "^44.5.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "yaml": "^2.9.0",
    "@nimiplatform/app-tools": "^0.12.0",
    "@nimiplatform/nimi-coding": "0.6.5",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/cli": "^4.3.3"
  },
  "main": "dist-electron/main.js"
}
